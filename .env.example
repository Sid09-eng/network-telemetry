# Copy to .env for local use. Never commit .env or credentials.
NETPULSE_ENV=development
NETPULSE_DRY_RUN=true
NETPULSE_ENABLE_LIVE_ACTIONS=false
NETPULSE_REMEDIATION_COOLDOWN_SECONDS=300
NETPULSE_REMEDIATION_COST=100
NETPULSE_REMEDIATION_COMMAND_TIMEOUT_SECONDS=10
NETPULSE_LINK_CAPACITY_BPS=100000000

# Local Grafana access. Set a unique value in ignored .env before use.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password

# Required for GCP deployment. Replace only in ignored .env/.tfvars files.
NETPULSE_GCP_PROJECT_ID=replace-with-your-project-id
NETPULSE_GCP_REGION=asia-southeast1
NETPULSE_GCP_ZONE=asia-southeast1-b
